# ==========================================
# BackupOps Environment Configuration Template
# ==========================================

# Core Application Environment
NODE_ENV=development
PORT=3000
BACKUP_OPS_ENV=development

# Database Configuration (PostgreSQL Control Plane)
POSTGRES_DB=backup_ops
POSTGRES_USER=backup_ops
POSTGRES_PASSWORD=backup_ops_development_password
DATABASE_URL=postgresql://backup_ops:backup_ops_development_password@localhost:5432/backup_ops

# Redis & BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Security & Authentication Secrets (Generate secure random strings in production)
BACKUP_OPS_JWT_SECRET=dev-jwt-secret-replace-in-production-min-32-chars
BACKUP_OPS_API_KEY=dev-api-key-replace-in-production
BACKUP_OPS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Agent Control Channel
AGENT_ID=agent-001
AGENT_PORT=8080
BACKUP_OPS_AGENT_ENDPOINT=http://localhost:8080
BACKUP_OPS_AGENT_SECRET=dev-agent-secret-replace-in-production

# Web UI Configuration
WEB_PORT=3001
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Durable Local Storage Mount (User host directory mapped into container)
BACKUP_STORAGE_PATH=./data/backups

# Development Demo Mode (Default is false; set to true only for mock seeding during frontend testing)
DEMO_MODE=false
